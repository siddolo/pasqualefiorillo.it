<mouse-trail aria-hidden="true"><canvas></canvas></mouse-trail>

<script>
  import { createMouseTrail } from '../scripts/mouse-trail';

  class MouseTrail extends HTMLElement {
    private cleanup?: () => void;

    connectedCallback() {
      const canvas = this.querySelector('canvas')!;
      const media = matchMedia('(prefers-reduced-motion: no-preference)');
      let destroy: (() => void) | undefined;
      const stop = () => { destroy?.(); destroy = undefined; };
      const update = () => {
        if (media.matches && !document.hidden) destroy ??= createMouseTrail(canvas);
        else stop();
      };
      media.addEventListener('change', update);
      document.addEventListener('visibilitychange', update);
      window.addEventListener('pagehide', stop);
      window.addEventListener('pageshow', update);
      update();
      this.cleanup = () => {
        stop();
        media.removeEventListener('change', update);
        document.removeEventListener('visibilitychange', update);
        window.removeEventListener('pagehide', stop);
        window.removeEventListener('pageshow', update);
      };
    }

    disconnectedCallback() { this.cleanup?.(); }
  }

  if (!customElements.get('mouse-trail')) customElements.define('mouse-trail', MouseTrail);
</script>

<style>
  /* A root-level layer above the body background and below all page content. */
  :global(body:has(mouse-trail)) { isolation: isolate; }
  mouse-trail {
    position: fixed;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    overflow: hidden;
    contain: strict;
  }
  canvas { display: block; width: 100%; height: 100%; }
  @media (prefers-reduced-motion: reduce) {
    mouse-trail { display: none; }
  }
  @media print { mouse-trail { display: none; } }
</style>
